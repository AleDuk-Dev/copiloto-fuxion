# ─────────────────────────────────────────────────────────────
# COPILOTO FUXION — Variables de entorno
# Copia este archivo como .env.local para desarrollo local.
# NUNCA subas .env.local a git. Está en .gitignore por defecto.
# ─────────────────────────────────────────────────────────────

# Anthropic — obtén tu API key en https://console.anthropic.com
# IMPORTANTE: Configura un spending limit ANTES de usar esta key
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — obtén estos valores en tu proyecto de Supabase
# Settings → API → Project URL y anon/public key
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Auth (Fase A) — los MISMOS valores de arriba, pero con
# prefijo NEXT_PUBLIC_ porque el login corre en el navegador.
# La anon key es pública por diseño; la seguridad la dan las
# policies de RLS (ver db/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Voyage AI (Fase B) — embeddings del RAG. Obtén tu key en
# https://dash.voyageai.com. Solo se usa en el servidor
# (lib/embeddings.ts es el único archivo que conoce el proveedor).
VOYAGE_API_KEY=pa-...

# Service role (Fase B) — SOLO para scripts/ingest.ts (npm run ingest),
# corre local, no en Vercel. NUNCA usarla en código de la app ni con
# prefijo NEXT_PUBLIC_: salta el RLS por diseño.
# Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe (Fase C1) — SOLO MODO TEST por ahora ───────────────
# Keys de test (sk_test_/pk_test_) del dashboard de Stripe.
# NO poner keys live sin decisión explícita de Alejandro.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Signing secret del webhook. Local: lo imprime `stripe listen
# --forward-to localhost:3000/api/stripe/webhook`. En Vercel: crear
# el endpoint (modo test) en el dashboard de Stripe apuntando a
# https://<dominio>/api/stripe/webhook y copiar el secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs de los tiers — los genera scripts/stripe-setup.ts
# (npx tsx scripts/stripe-setup.ts). Único lugar donde se
# configuran; el código los lee vía lib/planes.ts.
STRIPE_PRICE_INDIVIDUAL=price_...
STRIPE_PRICE_LIDER=price_...

# NOTA Fase C1: SUPABASE_SERVICE_ROLE_KEY ahora también la usa el
# servidor (webhook de Stripe y checkout — lib/supabase/admin.ts),
# así que debe estar configurada en Vercel, no solo en local.
