# ─────────────────────────────────────────────────────────────
# COPILOTO FUXION — Variables de entorno
# Copia este archivo como .env.local para desarrollo local.
# NUNCA subas .env.local a git. Está en .gitignore por defecto.
# ─────────────────────────────────────────────────────────────

# Anthropic — obtén tu API key en https://console.anthropic.com
# IMPORTANTE: Configura un spending limit ANTES de usar esta key
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — obtén estos valores en tu proyecto de Supabase
# Settings → API → Project URL y anon/public key
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
